# CampaignOS local AI worker. Copy to .env and fill in. Never commit .env.

# Supabase project (same values as the web app's VITE_ variables)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Dedicated worker account (invited in Supabase, role set to "AI worker" on the Team page).
# This is NOT the service-role key; never put the service-role key here.
WORKER_EMAIL=worker@yourdomain.com
WORKER_PASSWORD=
WORKER_NAME=ai-pc

# Local Ollama. Must be a loopback address; the worker refuses anything else.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_CONTEXT=16384

# Polling and heartbeat (seconds)
POLL_INTERVAL=5
MAX_POLL_INTERVAL=60
HEARTBEAT_SECONDS=30

# Optional: Figma adapter (also enable it in Settings in the web app)
FIGMA_TOKEN=

# Optional: local cache of OCR and analysis results, keyed by content hash
CACHE_DIR=./cache
