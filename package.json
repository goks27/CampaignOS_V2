{
  "name": "campaignos",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev -w apps/web --host",
    "build": "npm run build -w apps/web",
    "check": "npm run typecheck -w apps/web && npm run lint -w apps/web && npm run test -w apps/web && npm run build -w apps/web",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > apps/web/src/types/database.ts"
  }
}
